      "translations": {
        "sq": {
          "title": "Parashikim 21 ditë — Prostatol",
          "sections": [
            {
              "id": "opening",
              "key": "opening",
              "text": "Mirëdita {{first_name}}, jam {{agent_name}} nga Natura Therapy. Ju telefonoj për {{last_product}} që e porositët {{since_purchase}}."
            },
            {
              "id": "pitch",
              "key": "pitch",
              "text": "Si ndiheni? Shumë burra pas kutisë së parë zgjohen më rrallë natën."
            }
          ]
        }
      },
